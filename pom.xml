<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bank</groupId>
  <artifactId>banking-ai-platform</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Banking AI Platform</name>
  <description>Java + AI Banking Platform - Spring Boot Microservices with RAG, MCP and multi-LLM gateway</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>${java.version}</maven.compiler.source>
    <maven.compiler.target>${java.version}</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.3.4</spring-boot.version>
    <spring-cloud.version>2023.0.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- internal modules -->
      <dependency>
        <groupId>com.bank</groupId>
        <artifactId>common-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bank</groupId>
        <artifactId>common-exception</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bank</groupId>
        <artifactId>common-security</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bank</groupId>
        <artifactId>common-events</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bank</groupId>
        <artifactId>common-crypto</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.bank</groupId>
        <artifactId>ai-model-gateway</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>common/common-api</module>
    <module>common/common-exception</module>
    <module>common/common-security</module>
    <module>common/common-events</module>
    <module>common/common-crypto</module>

    <module>infrastructure/api-gateway</module>

    <module>banking-services/customer-service</module>
    <module>banking-services/account-service</module>
    <module>banking-services/transfer-service</module>
    <module>banking-services/payment-service</module>
    <module>banking-services/transaction-service</module>
    <module>banking-services/card-service</module>
    <module>banking-services/loan-service</module>
    <module>banking-services/notification-service</module>
    <module>banking-services/audit-service</module>
    <module>banking-services/fraud-service</module>

    <module>ai-platform/ai-model-gateway</module>
    <module>ai-platform/rag-service</module>
    <module>ai-platform/knowledge-service</module>
    <module>ai-platform/document-intelligence-service</module>
    <module>ai-platform/mcp-gateway-service</module>
    <module>ai-platform/ai-orchestrator-service</module>
    <module>ai-platform/fraud-ai-service</module>
    <module>ai-platform/report-insight-service</module>
  </modules>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!--
              Windows fix: Spring Boot's repackaged JAR writes absolute paths
              into MANIFEST.MF Class-Path. The Surefire forked JVM refuses to
              load classes from such a manifest on Windows, producing:
                "Unable to create test class '<TestClass>'"
              Disabling the URL check restores the expected behaviour.
              See: https://issues.apache.org/jira/browse/SUREFIRE-1588
            -->
            <argLine>-Djdk.net.URLClassPath.disableClassPathURLCheck=true</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- Required for Spring MVC to resolve @PathVariable / @RequestParam /
                 @RequestHeader parameter names via reflection at runtime.
                 Without this flag every controller method that relies on implicit
                 name matching throws IllegalArgumentException during request binding. -->
            <compilerArgs>
              <arg>-parameters</arg>
            </compilerArgs>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
